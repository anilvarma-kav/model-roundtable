# Fill only the keys for the cloud participants you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# GROK_API_KEY is also accepted as an alias for XAI_API_KEY.

# Bare names or matching LiteLLM provider/name strings both work.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GROK_MODEL=grok-4.6
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_BASE=http://localhost:11434
